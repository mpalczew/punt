#!/usr/bin/env bash
# Usage: bin/check [--staged|all|<gate>]   gates: build harness (harness always runs)
# No argument: run gates whose paths changed against main (working tree included).
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
git config core.hooksPath >/dev/null 2>&1 || git config core.hooksPath .githooks

GATES=(build harness)
build_paths=(Sources Package.swift Package.resolved)

step() {
  local label=$1 out
  shift
  if out=$("$@" 2>&1); then
    echo "✓ $label"
  else
    printf '%s\n' "$out" | awk 'length < 400'
    echo "✗ $label" >&2
    exit 1
  fi
}

harness_bad() {
  git ls-files .claude | rg -v '^\.claude/skills$' || true
  if [ -e .claude/skills ] || [ -L .claude/skills ]; then
    [ -L .claude/skills ] && [ "$(readlink .claude/skills)" = ../.agents/skills ] || echo .claude/skills
  fi
}
gate_harness() {
  local bad
  bad=$(harness_bad)
  if [ -n "$bad" ]; then printf '%s\n' "$bad"; exit 1; fi
  echo "✓ harness: .claude holds only the skills link"
}

gate_build() { step "build: swift build" swift build; }

changed() {
  local -n paths=$1
  [[ -n $(git diff --name-only main -- "${paths[@]}" 2>/dev/null; git ls-files --others --exclude-standard -- "${paths[@]}") ]]
}

staged_run() {
  local files tmp="" g p re
  files=$(git diff --cached --name-only --diff-filter=ACDMR)
  gate_harness
  for g in "${GATES[@]}"; do
    [[ $g == harness ]] && continue
    p="${g}_paths"; local -n ps=$p
    re="^($(IFS='|'; echo "${ps[*]}"))(/|$)"
    printf '%s\n' "$files" | rg -q "$re" || continue
    if [[ -z $tmp ]]; then
      tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
      git checkout-index -a --prefix="$tmp/"
      [[ -d .build ]] && ln -s "$PWD/.build" "$tmp/.build"
    fi
    (cd "$tmp" && "gate_$g") || exit 1
  done
  exit 0
}

arg=${1:-}
case $arg in
  --staged) staged_run ;;
  all) for g in "${GATES[@]}"; do "gate_$g"; done ;;
  "")
    gate_harness
    for g in "${GATES[@]}"; do
      [[ $g == harness ]] && continue
      p="${g}_paths"
      changed "$p" && "gate_$g"
    done
    exit 0 ;;
  *)
    [[ " ${GATES[*]} " == *" $arg "* ]] || { echo "unknown gate: $arg (gates: ${GATES[*]})" >&2; exit 2; }
    "gate_$arg" ;;
esac
